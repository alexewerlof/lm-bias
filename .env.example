# Any OpenAI-compatible server works (llama.cpp, Ollama, vLLM, LM Studio, ...).
LLM_ENDPOINT=http://localhost:8080/
LLM_MODEL=your-model-name

# Optional: only for hosted APIs that require a key. Omit it for local servers.
# LLM_TOKEN=your-api-key

# Model used by decision.js through llama.cpp's /v1/systemone endpoint. It must
# report "decisions" in its architecture.output_modalities (see GET /v1/models).
DECISION_MODEL=your-decision-model
